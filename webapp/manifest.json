{
  "_version": "1.80.0",
  "sap.app": {
    "id": "zppbomautomation",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.24.0",
      "toolsId": "887586ed-899e-468c-b969-519586910845"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_bom_automation_v4/srvd_a2x/sap/zui_bom_automation/0001/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "zc_bom_hdr_n-display": {
          "semanticObject": "zc_bom_hdr_n",
          "action": "display",
          "title": "{{zc_bom_hdr_n-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.142.12",
     "libs": {
  "sap.m": {},
  "sap.ui.core": {},
  "sap.ui.layout": {},
  "sap.ui.comp": {},
  "sap.ui.export": {}
}
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zppbomautomation.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
"routing": {
  "config": {
    "routerClass": "sap.m.routing.Router",
    "controlAggregation": "pages",
    "controlId": "app",
    "transition": "slide",
    "type": "View",
    "viewType": "XML",
    "path": "zppbomautomation.view",
    "async": true,
    "viewPath": "zppbomautomation.view"
  },
  "routes": [
    {
      "name": "RouteView1",
      "pattern": ":?query:",
      "target": [
        "TargetView1"
      ]
    },
    {
      "name": "RouteBOMItem",
      "pattern": "BOMItem",
      "target": [
        "TargetBOMItem"
      ]
    }
  ],
  "targets": {
    "TargetView1": {
      "id": "View1",
      "name": "View1"
    },
    "TargetBOMItem": {
      "id": "BOMItem",
      "name": "BOMItem"
    }
  }
},
    "rootView": {
      "viewName": "zppbomautomation.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
