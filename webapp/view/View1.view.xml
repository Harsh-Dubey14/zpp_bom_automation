<mvc:View
    controllerName="zppbomautomation.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    displayBlock="true"
>
    <Page
        id="pageBOMCreation"
        title="Material BOM Creation"
        showNavButton="false"
        backgroundDesign="Standard"
    >
        <customHeader>
            <Bar>
                <contentLeft>
                    <Title
                        text="Material BOM Creation"
                        level="H2"
                        class="sapUiSmallMarginBegin"
                    />
                </contentLeft>

                <contentRight>
                    <Button
                        icon="sap-icon://validate"
                        tooltip="Validate Material"
                        type="Transparent"
                        press=".onValidateMaterial"
                    />

                    <Button
                        icon="sap-icon://action"
                        tooltip="Continue"
                        type="Emphasized"
                        press=".onContinue"
                    />

                    <Button
                        icon="sap-icon://copy"
                        tooltip="Copy Existing BOM"
                        type="Transparent"
                        press=".onLoadCopyFromBomItems"
                    />

                    <Button
                        icon="sap-icon://edit"
                        tooltip="Change BOM"
                        text="Change BOM"
                        type="Transparent"
                        class="sapUiSmallMarginEnd"
                        press=".onChangeBOMPress"
                    />
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <VBox class="bomPageContent">
                <MessageStrip
                    id="msgStrip"
                    text="{headerModel>/Message}"
                    type="{headerModel>/MessageType}"
                    showIcon="true"
                    visible="{headerModel>/ShowMessage}"
                    class="sapUiSmallMarginBottom sapUiSmallMarginBegin sapUiSmallMarginEnd"
                />

                <Panel
                    id="inputForm"
                    headerText="Input Screen"
                    width="100%"
                    class="bomHeaderPanel sapUiSmallMarginBottom"
                >
                    <HBox
                        class="bomHeaderWrapper"
                        justifyContent="Center"
                        alignItems="Start"
                        width="100%"
                    >
                        <!-- LEFT COLUMN -->
                        <VBox class="bomHeaderColumn sapUiLargeMarginEnd">
                            <VBox class="bomFieldBox">
                                <Label
                                    text="Material"
                                    required="true"
                                />

                                <Input
                                    id="inpMaterial"
                                    value="{headerModel>/Material}"
                                    showValueHelp="true"
                                    valueHelpRequest=".onMaterialValueHelp"
                                    showSuggestion="true"
                                    filterSuggests="false"
                                    startSuggestion="1"
                                    liveChange=".onMaterialLiveChange"
                                    suggestionItemSelected=".onMaterialSuggestionSelected"
                                    suggestionRows="{materialSuggestModel>/items}"
                                    maxLength="40"
                                    width="20rem"
                                    placeholder="Enter Material / Description"
                                >
                                    <suggestionColumns>
                                        <Column>
                                            <Label text="Product" />
                                        </Column>
                                        <Column>
                                            <Label text="Description" />
                                        </Column>
                                    </suggestionColumns>

                                    <suggestionRows>
                                        <ColumnListItem>
                                            <cells>
                                                <Text
                                                    text="{materialSuggestModel>Product}"
                                                />
                                                <Text
                                                    text="{materialSuggestModel>ProductDescription}"
                                                />
                                            </cells>
                                        </ColumnListItem>
                                    </suggestionRows>
                                </Input>
                            </VBox>

                            <VBox class="bomFieldBox">
                                <Label
                                    text="Plant"
                                    required="true"
                                />

                                <Input
                                    id="inpPlant"
                                    value="{headerModel>/PlantDisplay}"
                                    showValueHelp="true"
                                    valueHelpRequest=".onPlantValueHelp"
                                    showSuggestion="true"
                                    liveChange=".onPlantLiveChange"
                                    suggestionItemSelected=".onPlantSuggestionSelected"
                                    suggestionRows="{plantSuggestModel>/items}"
                                    maxLength="80"
                                    width="20rem"
                                    placeholder="Enter Plant"
                                >
                                    <suggestionColumns>
                                        <Column>
                                            <Label text="Plant" />
                                        </Column>
                                        <Column>
                                            <Label text="Name" />
                                        </Column>
                                    </suggestionColumns>

                                    <suggestionRows>
                                        <ColumnListItem>
                                            <cells>
                                                <Text
                                                    text="{plantSuggestModel>Plant}"
                                                />
                                                <Text
                                                    text="{plantSuggestModel>PlantName}"
                                                />
                                            </cells>
                                        </ColumnListItem>
                                    </suggestionRows>
                                </Input>
                            </VBox>

                            <VBox class="bomFieldBox">
                                <Label
                                    text="BOM Usage"
                                    required="true"
                                />

                                <Input
                                    id="inpBomUsage"
                                    value="{headerModel>/BomUsage}"
                                    enabled="false"
                                    width="20rem"
                                />
                            </VBox>

                            <VBox class="bomFieldBox">
                                <Label
                                    text="Alternative BOM"
                                    required="true"
                                />

                                <Input
                                    id="inpAltBom"
                                    value="{headerModel>/AltBom}"
                                    enabled="false"
                                    maxLength="2"
                                    width="20rem"
                                    placeholder="Auto-filled after validation"
                                />
                            </VBox>
                        </VBox>

                        <!-- RIGHT COLUMN -->
                        <VBox class="bomHeaderColumn sapUiLargeMarginBegin">
                            <VBox class="bomFieldBox">
                                <Label
                                    text="Base Quantity"
                                    required="true"
                                />

                                <Input
                                    id="inpBaseQty"
                                    value="{headerModel>/BaseQty}"
                                    type="Number"
                                    liveChange=".onHeaderFieldChange"
                                    width="20rem"
                                    placeholder="Enter Base Quantity"
                                />
                            </VBox>

                            <VBox class="bomFieldBox">
                                <Label text="Valid From" />

                                <DatePicker
                                    id="dpValidFrom"
                                    value="{headerModel>/ValidFrom}"
                                    valueFormat="yyyy-MM-dd"
                                    displayFormat="dd/MM/yyyy"
                                    change=".onHeaderFieldChange"
                                    width="20rem"
                                />
                            </VBox>

                            <VBox class="bomFieldBox">
                                <Label text="Base UOM" />

                                <Input
                                    id="inpBaseUom"
                                    value="{headerModel>/BaseUom}"
                                    enabled="false"
                                    width="20rem"
                                    placeholder="Auto-filled after validation"
                                />
                            </VBox>

                            <VBox class="bomFieldBox">
                                <Label text="Alternative BOM Text" />

                                <Select
                                    id="selHeaderText"
                                    selectedKey="{headerModel>/HeaderText}"
                                    change=".onHeaderFieldChange"
                                    width="20rem"
                                    forceSelection="true"
                                    items="{styleGroupModel>/items}"
                                >
                                    <core:Item
                                        key="{styleGroupModel>StyleGroup}"
                                        text="{styleGroupModel>Text}"
                                    />
                                </Select>
                            </VBox>
                        </VBox>
                    </HBox>
                </Panel>

                <f:SimpleForm
                    id="copyFromForm"
                    title="Copy From"
                    editable="true"
                    layout="ResponsiveGridLayout"
                    labelSpanXL="3"
                    labelSpanL="3"
                    labelSpanM="4"
                    labelSpanS="12"
                    adjustLabelSpan="false"
                    emptySpanXL="6"
                    emptySpanL="5"
                    emptySpanM="2"
                    emptySpanS="0"
                    columnsXL="1"
                    columnsL="1"
                    columnsM="1"
                    singleContainerFullSize="false"
                    class="bomCopyFromForm"
                >
                    <f:content>
                        <Label text="Material" />

                        <Input
                            id="inpCopyMaterial"
                            value="{headerModel>/CopyMaterial}"
                            showValueHelp="true"
                            valueHelpRequest=".onCopyMaterialValueHelp"
                            showSuggestion="true"
                            filterSuggests="false"
                            startSuggestion="1"
                            liveChange=".onCopyMaterialLiveChange"
                            suggestionItemSelected=".onCopyMaterialSuggestionSelected"
                            suggestionRows="{materialSuggestModel>/items}"
                            maxLength="40"
                            placeholder="Enter Copy Material / Description"
                        >
                            <suggestionColumns>
                                <Column>
                                    <Label text="Product" />
                                </Column>
                                <Column>
                                    <Label text="Description" />
                                </Column>
                            </suggestionColumns>

                            <suggestionRows>
                                <ColumnListItem>
                                    <cells>
                                        <Text
                                            text="{materialSuggestModel>Product}"
                                        />
                                        <Text
                                            text="{materialSuggestModel>ProductDescription}"
                                        />
                                    </cells>
                                </ColumnListItem>
                            </suggestionRows>
                        </Input>

                        <Label text="Plant" />

                        <Input
                            id="inpCopyPlant"
                            value="{headerModel>/CopyPlantDisplay}"
                            showValueHelp="true"
                            valueHelpRequest=".onCopyPlantValueHelp"
                            showSuggestion="true"
                            liveChange=".onCopyPlantLiveChange"
                            suggestionItemSelected=".onCopyPlantSuggestionSelected"
                            suggestionRows="{plantSuggestModel>/items}"
                            maxLength="80"
                            placeholder="Enter Copy Plant"
                        >
                            <suggestionColumns>
                                <Column>
                                    <Label text="Plant" />
                                </Column>
                                <Column>
                                    <Label text="Name" />
                                </Column>
                            </suggestionColumns>

                            <suggestionRows>
                                <ColumnListItem>
                                    <cells>
                                        <Text
                                            text="{plantSuggestModel>Plant}"
                                        />
                                        <Text
                                            text="{plantSuggestModel>PlantName}"
                                        />
                                    </cells>
                                </ColumnListItem>
                            </suggestionRows>
                        </Input>

                        <Label text="Alternative BOM" />

                        <HBox alignItems="Center">
                            <Input
                                id="inpCopyAltBom"
                                value="{headerModel>/CopyAltBom}"
                                type="Number"
                                liveChange=".onHeaderFieldChange"
                                maxLength="2"
                                placeholder="Enter Copy Alt BOM"
                            />

                            <Button
                                icon="sap-icon://arrow-right"
                                tooltip="Fetch Existing BOM"
                                type="Transparent"
                                class="sapUiTinyMarginBegin"
                                press=".onLoadCopyFromBomItems"
                            />
                        </HBox>
                    </f:content>
                </f:SimpleForm>
            </VBox>
        </content>

        <footer>
            <OverflowToolbar>
                <ToolbarSpacer />

                <Button
                    text="Validate"
                    icon="sap-icon://validate"
                    press=".onValidateMaterial"
                />

                <Button
                    text="Continue"
                    type="Emphasized"
                    press=".onContinue"
                />

                <Button
                    text="Cancel"
                    press=".onCancel"
                />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
