<mvc:View controllerName="zppbomautomation.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core" displayBlock="true">

    <Page id="pageBOMCreation" title="Material BOM Creation" showNavButton="false" backgroundDesign="Standard">

        <customHeader>
            <Bar>
                <contentLeft>
                    <Title text="Material BOM Creation" level="H2" class="sapUiSmallMarginBegin" />
                </contentLeft>

                <contentRight>
                    <Button icon="sap-icon://validate" tooltip="Validate Material" type="Transparent" press=".onValidateMaterial" />

                    <Button icon="sap-icon://action" tooltip="Continue" type="Emphasized" press=".onContinue" />

                    <Button icon="sap-icon://copy" tooltip="Copy Existing BOM" type="Transparent" class="sapUiSmallMarginEnd" press=".onLoadCopyFromBomItems"/>
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <VBox class="sapUiResponsiveContentPadding">

                <MessageStrip id="msgStrip" text="{headerModel>/Message}" type="{headerModel>/MessageType}" showIcon="true" visible="{headerModel>/ShowMessage}" class="sapUiSmallMarginBottom" />

                <f:SimpleForm id="inputForm" title="Input Screen" editable="true" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="6" emptySpanL="5" emptySpanM="2" emptySpanS="0" columnsXL="1" columnsL="1" columnsM="1" singleContainerFullSize="false">

                    <f:content>
                        <Label text="Material" required="true" />

                        <Input id="inpMaterial" value="{headerModel>/Material}" showValueHelp="true" valueHelpRequest=".onMaterialValueHelp" liveChange=".onHeaderFieldChange" maxLength="40" placeholder="Enter Material" />

                        <Label text="Plant" required="true" />

                        <Input id="inpPlant" value="{headerModel>/Plant}" showValueHelp="true" valueHelpRequest=".onPlantValueHelp" liveChange=".onHeaderFieldChange" maxLength="4" placeholder="Enter Plant" />

                        <Label text="BOM Usage" required="true" />

                        <Input value="{headerModel>/BomUsage}" editable="false" enabled="false" />

                        <Label text="Alternative BOM" required="true" />

                        <Input id="inpAltBom" value="{headerModel>/AltBom}" editable="false" maxLength="2" placeholder="Auto-filled after validation" />

                        <Label text="Base Quantity" required="true" />

                        <Input id="inpBaseQty" value="{headerModel>/BaseQty}" type="Number" liveChange=".onHeaderFieldChange" placeholder="Enter Base Quantity" />

                        <Label text="Valid From" />

                        <DatePicker id="dpValidFrom" value="{headerModel>/ValidFrom}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" change=".onHeaderFieldChange" />

                        <Label text="Base UOM" />

                        <Input id="inpBaseUom" value="{headerModel>/BaseUom}" editable="false" placeholder="Auto-filled after validation" />
                    </f:content>
                </f:SimpleForm>

                <f:SimpleForm id="copyFromForm" title="Copy From" editable="true" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="6" emptySpanL="5" emptySpanM="2" emptySpanS="0" columnsXL="1" columnsL="1" columnsM="1" singleContainerFullSize="false">

                    <f:content>
                        <Label text="Material" />

                        <Input id="inpCopyMaterial" value="{headerModel>/CopyMaterial}" showValueHelp="true" valueHelpRequest=".onCopyMaterialValueHelp" liveChange=".onHeaderFieldChange" maxLength="40" placeholder="Enter Copy Material" />

                        <Label text="Plant" />

                        <Input id="inpCopyPlant" value="{headerModel>/CopyPlant}" showValueHelp="true" valueHelpRequest=".onCopyPlantValueHelp" liveChange=".onHeaderFieldChange" maxLength="4" placeholder="Enter Copy Plant" />


                        <Label text="Alternative BOM" />

                        <HBox alignItems="Center">
                            <Input id="inpCopyAltBom" value="{headerModel>/CopyAltBom}" liveChange=".onHeaderFieldChange" maxLength="2" placeholder="Enter Copy Alt BOM" />

                           <Button
    icon="sap-icon://arrow-right"
    tooltip="Fetch Existing BOM"
    type="Transparent"
    class="sapUiTinyMarginBegin"
    press=".onLoadCopyFromBomItems" />
                        </HBox>
                    </f:content>
                </f:SimpleForm>

            </VBox>
        </content>

        <footer>
            <OverflowToolbar>
                <ToolbarSpacer />

                <Button text="Validate" icon="sap-icon://validate" press=".onValidateMaterial" />

                <Button text="Continue" type="Emphasized" press=".onContinue" />

                <Button text="Cancel" press=".onCancel" />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>