<mvc:View
    controllerName="zppbomautomation.controller.BOMChangeItem"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true"
>
    <Page
        id="pageBOMChangeItemScreen"
        title="Change Material BOM"
        showNavButton="true"
        navButtonPress=".onNavBack"
    >
        <content>
            <VBox class="bomPageContent">
                <MessageStrip
                    id="msgStripBOMChangeItem"
                    text="{resultModel>/Message}"
                    type="{resultModel>/MessageType}"
                    showIcon="true"
                    visible="{resultModel>/ShowMessage}"
                    class="sapUiSmallMarginBottom sapUiSmallMarginBegin sapUiSmallMarginEnd"
                />

                <Panel
                    id="changeHeaderForm"
                    headerText="Existing BOM Header Information"
                    expandable="true"
                    expanded="true"
                    width="100%"
                    class="bomHeaderPanel sapUiSmallMarginBottom"
                >
                    <HBox
                        class="bomHeaderWrapper"
                        justifyContent="Center"
                        alignItems="Start"
                        width="100%"
                    >
                        <!-- LEFT COLUMN -->
                        <VBox class="bomHeaderColumn sapUiLargeMarginEnd">
                            <VBox class="bomFieldBox">
                                <Label text="BOM Number" />
                                <Text text="{headerModel>/BillOfMaterial}" />
                            </VBox>

                            <VBox class="bomFieldBox">
                                <Label text="Material" />
                                <Text text="{headerModel>/Material}" />
                            </VBox>

                            <VBox class="bomFieldBox">
                                <Label text="Plant" />
                                <Text text="{= ${headerModel>/PlantDisplay} || ${headerModel>/Plant} }" />
                            </VBox>

                            <VBox class="bomFieldBox">
                                <Label text="BOM Category" />
                                <Text text="{headerModel>/BillOfMaterialCategory}" />
                            </VBox>

                            <VBox class="bomFieldBox">
                                <Label text="BOM Usage" />
                                <Text text="{headerModel>/BomUsage}" />
                            </VBox>

                            <VBox class="bomFieldBox">
                                <Label text="Alternative BOM" />
                                <Text text="{headerModel>/AltBom}" />
                            </VBox>
                        </VBox>

                        <!-- RIGHT COLUMN -->
                        <VBox class="bomHeaderColumn sapUiLargeMarginBegin">
                            <VBox class="bomFieldBox">
                                <Label text="Base Quantity" />
                                <Text text="{headerModel>/BaseQty}" />
                            </VBox>

                            <VBox class="bomFieldBox">
                                <Label text="Valid From" />
                                <Text text="{headerModel>/ValidFrom}" />
                            </VBox>

                            <VBox class="bomFieldBox">
                                <Label text="Base UOM" />
                                <Text text="{headerModel>/BaseUom}" />
                            </VBox>

                            <VBox class="bomFieldBox">
                                <Label text="Alternative BOM Text" />
                                <Text
                                    text="{headerModel>/HeaderText}"
                                    wrapping="true"
                                    width="20rem"
                                />
                            </VBox>

                            <VBox class="bomFieldBox">
                                <Label text="Request Status" />
                                <ObjectStatus
                                    text="{resultModel>/Status}"
                                    state="{resultModel>/StatusState}"
                                />
                            </VBox>

                            <VBox class="bomFieldBox">
                                <Label text="Message" />

                                <Text
                                    text="{resultModel>/Message}"
                                    wrapping="true"
                                    width="20rem"
                                />

                                <Button
                                    id="btnShowMoreMessage"
                                    text="Show More"
                                    type="Transparent"
                                    icon="sap-icon://detail-view"
                                    press=".onShowMoreMessage"
                                    visible="{resultModel>/ShowMore}"
                                    class="sapUiTinyMarginTop"
                                />
                            </VBox>
                        </VBox>
                    </HBox>
                </Panel>

                <Table
                    id="tblBOMChangeItems"
                    inset="false"
                    growing="true"
                    items="{itemModel>/items}"
                    mode="MultiSelect"
                    sticky="ColumnHeaders,HeaderToolbar"
                    class="sapUiSmallMarginTop"
                >
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title
                                text="BOM Items"
                                level="H3"
                            />

                            <ToolbarSpacer />

                            <Button
                                id="btnChangeItemAdd"
                                icon="sap-icon://add"
                                text="Add"
                                type="Emphasized"
                                press=".onAddRow"
                                enabled="{resultModel>/Editable}"
                            />

                            <Button
                                id="btnChangeItemDelete"
                                text="Delete"
                                icon="sap-icon://delete"
                                type="Reject"
                                press=".onDelete"
                                enabled="{resultModel>/Editable}"
                            />

                            <Button
                                id="btnChangeItemSelectAll"
                                text="Select All"
                                icon="sap-icon://multi-select"
                                press=".onSelectAll"
                                enabled="{resultModel>/Editable}"
                            />
                        </OverflowToolbar>
                    </headerToolbar>

                    <columns>
                        <Column
                            width="4.5rem"
                            hAlign="Center"
                        >
                            <Text text="Item" />
                        </Column>

                        <Column
                            width="13rem"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                        >
                            <Text text="Component" />
                        </Column>

                        <Column
                            width="16rem"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                        >
                            <Text text="Description" />
                        </Column>

                        <Column
                            width="8rem"
                            hAlign="End"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                        >
                            <Text text="Quantity" />
                        </Column>

                        <Column
                            width="4.5rem"
                            minScreenWidth="Desktop"
                            demandPopin="true"
                        >
                            <Text text="UoM" />
                        </Column>

                        <Column
                            width="9rem"
                            minScreenWidth="Desktop"
                            demandPopin="true"
                        >
                            <Text text="Sort String" />
                        </Column>

                        <Column
                            width="16rem"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                        >
                            <Text text="Remarks" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem
                            vAlign="Middle"
                            type="Inactive"
                            highlight="{= ${itemModel>rowStatus} === 'DELETED' ? 'Error' : ${itemModel>rowStatus} === 'NEW' ? 'Success' : ${itemModel>rowStatus} === 'CHANGED' ? 'Warning' : 'None' }"
                        >
                            <cells>
                                <Text text="{itemModel>item}" />

                                <Input
                                    value="{itemModel>component}"
                                    showValueHelp="true"
                                    valueHelpRequest=".onComponentValueHelp"
                                    showSuggestion="true"
                                    filterSuggests="false"
                                    startSuggestion="1"
                                    suggest=".onComponentSuggest"
                                    suggestionItemSelected=".onComponentSuggestionSelected"
                                    suggestionRows="{componentSuggestModel>/items}"
                                    change=".onComponentChange"
                                    editable="{= ${resultModel>/Editable} &amp;&amp; ${itemModel>rowStatus} !== 'DELETED' }"
                                    maxLength="40"
                                    placeholder="Enter Component"
                                >
                                    <suggestionColumns>
                                        <Column><Text text="Component" /></Column>
                                        <Column><Text text="Description" /></Column>
                                        <Column><Text text="UoM" /></Column>
                                    </suggestionColumns>
                                    <suggestionRows>
                                        <ColumnListItem>
                                            <cells>
                                                <Text text="{componentSuggestModel>component}" />
                                                <Text text="{componentSuggestModel>ProductDescription}" />
                                                <Text text="{componentSuggestModel>uom}" />
                                            </cells>
                                        </ColumnListItem>
                                    </suggestionRows>
                                </Input>

                                <TextArea
                                    value="{itemModel>description}"
                                    editable="false"
                                    maxLength="40"
                                    growing="true"
                                    growingMaxLines="3"
                                    rows="1"
                                    width="100%"
                                />

                                <Input
                                    value="{itemModel>quantity}"
                                    textAlign="End"
                                    type="Text"
                                    liveChange=".onQuantityLiveChange"
                                    change=".onQuantityChange"
                                    editable="{= ${resultModel>/Editable} &amp;&amp; ${itemModel>rowStatus} !== 'DELETED' }"
                                    placeholder="Enter Quantity"
                                />

                                <Input
                                    value="{itemModel>uom}"
                                    width="100%"
                                    editable="{= ${resultModel>/Editable} &amp;&amp; ${itemModel>rowStatus} !== 'DELETED' }"
                                    showValueHelp="true"
                                    valueHelpRequest=".onUomValueHelp"
                                    maxLength="3"
                                    placeholder="UoM"
                                    liveChange=".onUomManualInputBlock"
                                />

                                <Input
                                    value="{itemModel>sortString}"
                                    showValueHelp="true"
                                    valueHelpRequest=".onSortStringValueHelp"
                                    change=".onSortStringChange"
                                    editable="{= ${resultModel>/Editable} &amp;&amp; ${itemModel>rowStatus} !== 'DELETED' }"
                                    maxLength="10"
                                    placeholder="Sort String"
                                />

                                <Input
                                    value="{itemModel>remarks}"
                                    editable="{= ${resultModel>/Editable} &amp;&amp; ${itemModel>rowStatus} !== 'DELETED' }"
                                    maxLength="40"
                                    change=".onRemarksChange"
                                    placeholder="Enter Remarks"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>

        <footer>
            <OverflowToolbar>
                <ToolbarSpacer />

                <Button
                    id="btnPostBOMChanges"
                    text="Post Changes"
                    type="Emphasized"
                    icon="sap-icon://upload-to-cloud"
                    press=".onPostChanges"
                    enabled="{resultModel>/CanSave}"
                />

                <Button
                    id="btnCancelBOMChanges"
                    text="Cancel"
                    press=".onCancel"
                />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
