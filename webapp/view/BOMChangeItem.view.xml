<mvc:View
    controllerName="zppbomautomation.controller.BOMChangeItem"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    displayBlock="true"
>
    <Page
        id="pageBOMChangeItemScreen"
        title="Change Material BOM"
        showNavButton="true"
        navButtonPress=".onNavBack"
    >
        <content>
            <VBox class="sapUiResponsiveContentPadding">
                <MessageStrip
                    id="msgStripBOMChangeItem"
                    text="{resultModel>/Message}"
                    type="{resultModel>/MessageType}"
                    showIcon="true"
                    visible="{resultModel>/ShowMessage}"
                    class="sapUiSmallMarginBottom"
                />

                <f:SimpleForm
                    id="changeHeaderForm"
                    title="Existing BOM Header Information"
                    editable="false"
                    layout="ResponsiveGridLayout"
                    labelSpanXL="3"
                    labelSpanL="3"
                    labelSpanM="4"
                    labelSpanS="12"
                    columnsXL="2"
                    columnsL="2"
                    columnsM="1"
                >
                    <f:content>
                        <Label text="BOM Number" />
                        <Text text="{headerModel>/BillOfMaterial}" />

                        <Label text="Material" />
                        <Text text="{headerModel>/Material}" />

                        <Label text="Plant" />
                        <Text text="{headerModel>/Plant}" />

                        <Label text="BOM Category" />
                        <Text text="{headerModel>/BillOfMaterialCategory}" />

                        <Label text="BOM Usage" />
                        <Text text="{headerModel>/BomUsage}" />

                        <Label text="Alternative BOM" />
                        <Text text="{headerModel>/AltBom}" />

                        <Label text="Base Quantity" />
                        <Text text="{headerModel>/BaseQty}" />

                        <Label text="Valid From" />
                        <Text text="{headerModel>/ValidFrom}" />

                        <Label text="Base UOM" />
                        <Text text="{headerModel>/BaseUom}" />

                        <Label text="Message" />
                        <Text text="{resultModel>/Message}" />
                    </f:content>
                </f:SimpleForm>

                <Table
                    id="tblBOMChangeItems"
                    inset="false"
                    growing="true"
                    items="{itemModel>/items}"
                    mode="MultiSelect"
                    sticky="ColumnHeaders,HeaderToolbar"
                    class="sapUiSmallMarginTop"
                >
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title
                                text="BOM Items"
                                level="H3"
                            />

                            <ToolbarSpacer />

                            <Button
                                id="btnChangeItemAdd"
                                icon="sap-icon://add"
                                text="Add"
                                type="Emphasized"
                                press=".onAddRow"
                                enabled="{resultModel>/Editable}"
                            />

                            <Button
                                id="btnChangeItemDelete"
                                text="Delete"
                                icon="sap-icon://delete"
                                type="Reject"
                                press=".onDelete"
                                enabled="{resultModel>/Editable}"
                            />

                            <Button
                                id="btnChangeItemSelectAll"
                                text="Select All"
                                icon="sap-icon://multi-select"
                                press=".onSelectAll"
                                enabled="{resultModel>/Editable}"
                            />
                        </OverflowToolbar>
                    </headerToolbar>

                    <columns>
                        <Column
                            width="5rem"
                            hAlign="Center"
                        >
                            <Text text="Item" />
                        </Column>

                        <Column
                            width="14rem"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                        >
                            <Text text="Component" />
                        </Column>

                        <Column
                            width="24rem"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                        >
                            <Text text="Description" />
                        </Column>

                        <Column
                            width="8rem"
                            hAlign="End"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                        >
                            <Text text="Quantity" />
                        </Column>

                        <Column
                            width="6rem"
                            minScreenWidth="Desktop"
                            demandPopin="true"
                        >
                            <Text text="UoM" />
                        </Column>

                        <Column
                            width="10rem"
                            minScreenWidth="Desktop"
                            demandPopin="true"
                        >
                            <Text text="Sort String" />
                        </Column>

                        <Column
                            width="6rem"
                            hAlign="Center"
                            minScreenWidth="Desktop"
                            demandPopin="true"
                        >
                            <Text text="Category" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem
                            vAlign="Middle"
                            type="Inactive"
                            highlight="{= ${itemModel>rowStatus} === 'DELETED' ? 'Error' : ${itemModel>rowStatus} === 'NEW' ? 'Success' : ${itemModel>rowStatus} === 'CHANGED' ? 'Warning' : 'None' }"
                        >
                            <cells>
                                <Text text="{itemModel>item}" />

                                <Input
                                    value="{itemModel>component}"
                                    showValueHelp="true"
                                    valueHelpRequest=".onComponentValueHelp"
                                    change=".onComponentChange"
                                    editable="{= ${resultModel>/Editable} &amp;&amp; ${itemModel>rowStatus} !== 'DELETED' }"
                                    maxLength="40"
                                    placeholder="Enter Component"
                                />

                                <TextArea
                                    value="{itemModel>description}"
                                    editable="false"
                                    growing="true"
                                    growingMaxLines="10"
                                    rows="1"
                                    width="100%"
                                />

                                <Input
                                    value="{itemModel>quantity}"
                                    textAlign="End"
                                    type="Text"
                                    liveChange=".onQuantityLiveChange"
                                    change=".onQuantityChange"
                                    editable="{= ${resultModel>/Editable} &amp;&amp; ${itemModel>rowStatus} !== 'DELETED' }"
                                    placeholder="Enter Quantity"
                                />

                                <Input
                                    value="{itemModel>uom}"
                                    width="5rem"
                                    editable="{= ${resultModel>/Editable} &amp;&amp; ${itemModel>rowStatus} !== 'DELETED' }"
                                    placeholder="UoM"
                                    change=".onUomChange"
                                />

                                <Input
                                    value="{itemModel>sortStringValue}"
                                    showValueHelp="true"
                                    valueHelpRequest=".onSortStringValueHelp"
                                    change=".onSortStringChange"
                                    editable="{= ${resultModel>/Editable} &amp;&amp; ${itemModel>rowStatus} !== 'DELETED' }"
                                    maxLength="10"
                                    placeholder="Sort String"
                                />

                                <Input
                                    value="{itemModel>category}"
                                    width="3rem"
                                    editable="false"
                                    maxLength="1"
                                    placeholder="Category"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>

        <footer>
            <OverflowToolbar>
                <ToolbarSpacer />

                <Button
                    id="btnPostBOMChanges"
                    text="Post Changes"
                    type="Emphasized"
                    icon="sap-icon://upload-to-cloud"
                    press=".onPostChanges"
                    enabled="{resultModel>/CanSave}"
                />

                <Button
                    id="btnCancelBOMChanges"
                    text="Cancel"
                    press=".onCancel"
                />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
